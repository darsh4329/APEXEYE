# ==================================================
# APEXEYE LINUX CLIENT CONFIGURATION
# ==================================================
# Copy this file to .env in your client_linux directory and adjust settings.
# Automatic Master LAN discovery (UDP 9101) is active by default.
# NEVER commit production credentials to version control.

# --------------------------------------------------
# MASTER SERVER CONNECTION (OPTIONAL OVERRIDE)
# --------------------------------------------------
# Optional explicit override.
# Leave unset or commented out to use Automatic LAN Master Discovery.
APEXEYE_MASTER_URL=

# Client Identifier (optional, will be auto-generated UUID if left empty)
APEXEYE_CLIENT_ID=
APEXEYE_CLIENT_UI_PORT=9200

# Pre-configured Device Credentials (optional)
# APEXEYE_DEVICE_ID=
# APEXEYE_AUTH_TOKEN=

# Logging
APEXEYE_CLIENT_LOG_PATH=logs
APEXEYE_CLIENT_LOG_LEVEL=DEBUG

# Telemetry & Heartbeat Intervals (in seconds) — FROZEN APEXEYE TIMING
APEXEYE_HEARTBEAT_INTERVAL_SECONDS=3
APEXEYE_CLIENT_TELEMETRY_INTERVAL_SECONDS=10
APEXEYE_EVENT_SCAN_INTERVAL_SECONDS=5
APEXEYE_HOST_INFO_INTERVAL_SECONDS=300
