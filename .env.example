# ==================================================
# APEXEYE CONFIGURATION (TEMPLATE)
# ==================================================
# Copy this file to .env and fill in your values.
# NEVER commit credentials or active secrets to version control.

# --------------------------------------------------
# MASTER CONFIGURATION
# --------------------------------------------------
APEXEYE_ENV=development
APEXEYE_MASTER_HOST=0.0.0.0
APEXEYE_MASTER_PORT=9100

# Explicit advertised LAN IP override (optional - auto-discovered if not set)
# APEXEYE_ADVERTISE_IP=10.177.134.109

APEXEYE_DB_PATH=database/apexeye.db
APEXEYE_LOG_PATH=logs
APEXEYE_LOG_LEVEL=DEBUG

# Authentication (Phase 1+)
# APEXEYE_AUTH_SECRET_KEY=change-me-to-a-random-secret
# APEXEYE_AUTH_TOKEN_EXPIRY_HOURS=24

# Telemetry (Phase 2+)
# APEXEYE_TELEMETRY_INTERVAL_SECONDS=60

# CCTV Monitoring (Phase 4)
# APEXEYE_CCTV_CHECK_INTERVAL_SECONDS=30

# --------------------------------------------------
# CLIENT CONFIGURATION
# --------------------------------------------------
APEXEYE_CLIENT_ID=

# Master URL (takes precedence over separate host/port)
# Examples:
#   Same machine (testing):   http://127.0.0.1:9100
#   Physical LAN / Wi-Fi:     http://10.177.134.109:9100 (replace with Master's actual IP)
#   VPN / Overlay Network:    http://100.x.y.z:9100 (e.g., Tailscale / WireGuard)
# NOTE: Replace 10.177.134.109 with the Master PC's actual LAN IP reported by python -m master.main.
APEXEYE_MASTER_URL=http://10.177.134.109:9100

APEXEYE_CLIENT_UI_PORT=9200
APEXEYE_CLIENT_LOG_PATH=logs
APEXEYE_CLIENT_LOG_LEVEL=DEBUG

# Client intervals (Phase 2+)
# APEXEYE_HEARTBEAT_INTERVAL_SECONDS=3
# APEXEYE_CLIENT_TELEMETRY_INTERVAL_SECONDS=60
