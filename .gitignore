# ==================================================
# APEXEYE .gitignore
# ==================================================

# --- Byte-compiled / optimized / DLL files ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll
*.dylib

# --- Caches & Diagnostics ---
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Environment & Secret Configuration ---
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# Keep template intact
!.env.example

# --- Database & Storage ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm
!database/.gitkeep

# --- Runtime Logs ---
logs/
*.log
logs/*.log
!logs/.gitkeep

# --- Generated PDF Reports & Exports ---
reports/*.pdf
scratch/sample_reports/*.pdf
!reports/.gitkeep

# --- Distribution / Packaging / PyInstaller ---
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.spec
*.exe
*.bin
*.zip
*.tar.gz

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
