# ==================================================
# APEXEYE CLIENT CONFIGURATION
# ==================================================
# Copy this file to .env in your client directory and adjust settings.
# Automatic Master LAN discovery (UDP 9101) is active by default.
# NEVER commit production credentials to version control.

# --------------------------------------------------
# MASTER SERVER CONNECTION (OPTIONAL OVERRIDE)
# --------------------------------------------------
# Optional explicit override for fixed servers, remote networks, or VLANs.
# Leave unset or commented out to use Automatic LAN Master Discovery.
#
# Examples:
#   # Automatic LAN Discovery (recommended):
#   # (Leave APEXEYE_MASTER_URL commented out)
#
#   # Explicit LAN IP:
#   # APEXEYE_MASTER_URL=http://10.165.255.109:9100
#
#   # Stable Hostname:
#   # APEXEYE_MASTER_URL=http://apexeye-master:9100
# APEXEYE_MASTER_URL=

# Client Identifier (optional, will be auto-generated UUID if left empty)
APEXEYE_CLIENT_ID=

# Pre-configured Device Credentials (optional, can also be paired via terminal or local web UI at http://127.0.0.1:9200)
# APEXEYE_DEVICE_ID=
# APEXEYE_AUTH_TOKEN=

# Client Local UI Port (Local Auth screen & telemetry dashboard on http://127.0.0.1:9200)
APEXEYE_CLIENT_UI_PORT=9200

# Logging
APEXEYE_CLIENT_LOG_PATH=logs
APEXEYE_CLIENT_LOG_LEVEL=DEBUG

# Telemetry & Heartbeat Intervals (in seconds)
APEXEYE_HEARTBEAT_INTERVAL_SECONDS=30
APEXEYE_CLIENT_TELEMETRY_INTERVAL_SECONDS=60
APEXEYE_EVENT_SCAN_INTERVAL_SECONDS=5
APEXEYE_HOST_INFO_INTERVAL_SECONDS=300
